<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.ultikits.docs</groupId>
    <artifactId>ultitools-doc-examples</artifactId>
    <version>1.0.0</version>
    <packaging>jar</packaging>

    <description>
        Compilable examples embedded in the UltiTools developer documentation.
        This module is never published. Its only purpose is to fail the build
        when a documented API no longer exists in the released UltiTools-API.
        Coverage note: this gate only protects examples that have been migrated
        to `&lt;&lt;&lt;` snippet references into this module. Of the 218 Java code
        blocks across the docs site, 78 have been migrated so far; the remaining
        140 are still inline code blocks in docs/src and are not covered or
        verified by this build. Most of those 140 are deliberate fragments
        (method bodies elided with `...`) that cannot compile standalone and are
        not migration candidates.
    </description>

    <properties>
        <!-- Must equal versionsConfig.current in .vitepress/config.mts
             and the latest <release> on Maven Central. Verified by CI. -->
        <ultitools.version>6.2.5</ultitools.version>
        <java.version>1.8</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <repositories>
        <repository>
            <id>papermc</id>
            <url>https://repo.papermc.io/repository/maven-public/</url>
        </repository>
    </repositories>

    <dependencies>
        <dependency>
            <groupId>com.ultikits</groupId>
            <artifactId>UltiTools-API</artifactId>
            <version>${ultitools.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>io.papermc.paper</groupId>
            <artifactId>paper-api</artifactId>
            <version>1.21.11-R0.1-SNAPSHOT</version>
            <scope>provided</scope>
        </dependency>
        <!-- Only present so the @Configuration/@Bean example can wrap a real
             connection pool. Same coordinates the framework itself declares. -->
        <dependency>
            <groupId>com.zaxxer</groupId>
            <artifactId>HikariCP</artifactId>
            <version>5.1.0</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <version>1.18.38</version>
            <scope>provided</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <configuration>
                    <source>${java.version}</source>
                    <target>${java.version}</target>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <!-- Not active by default. See pending-examples/test-utils/README.md for the full
         explanation. The example living there uses ultikits-test-utils, which is written
         but not yet published to Maven Central (framework repository .planning/phases/
         08-gate-hardening-release-closeout/08-RELEASE-PACKAGE.md section 4.2). Declaring
         that dependency in the default <dependencies> block above would fail dependency
         resolution on every push and every PR against this repository, long before the
         compiler ever gets a chance to see the file. Profile isolation, not a compiler
         exclude, is what keeps that off the default build. -->
    <profiles>
        <profile>
            <!-- Lifting condition: activate this profile (or fold its <dependency> and
                 <build> additions into the defaults above) once com.ultikits:
                 ultikits-test-utils:1.0.0 is published and resolvable from Maven Central. -->
            <id>test-utils-examples</id>
            <activation>
                <activeByDefault>false</activeByDefault>
            </activation>
            <!-- add-source below, not add-test-source: every other example in this project
                 is a plain compiled class under src/main/java, never actually run via
                 mvn test, so this keeps the same convention rather than introducing a
                 second one. Scope is compile, not the test scope a real consumer should
                 use (per ultikits-test-utils's own README). add-source puts the pending
                 file on the MAIN compile classpath, and a test-scope dependency is not on
                 that classpath at all, so compile scope here is a build-verification
                 convenience for this project only, not usage guidance. -->
            <dependencies>
                <dependency>
                    <groupId>com.ultikits</groupId>
                    <artifactId>ultikits-test-utils</artifactId>
                    <version>1.0.0</version>
                    <scope>compile</scope>
                </dependency>
            </dependencies>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>build-helper-maven-plugin</artifactId>
                        <version>3.6.0</version>
                        <executions>
                            <execution>
                                <id>add-test-utils-pending-source</id>
                                <phase>generate-sources</phase>
                                <goals>
                                    <goal>add-source</goal>
                                </goals>
                                <configuration>
                                    <sources>
                                        <source>pending-examples/test-utils</source>
                                    </sources>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
