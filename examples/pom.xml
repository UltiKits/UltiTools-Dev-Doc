<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.ultikits.docs</groupId>
    <artifactId>ultitools-doc-examples</artifactId>
    <version>1.0.0</version>
    <packaging>jar</packaging>

    <description>
        Compilable examples embedded in the UltiTools developer documentation.
        This module is never published. Its only purpose is to fail the build
        when a documented API no longer exists in the released UltiTools-API.
        Only snippet references into this module are compiled; inline Java
        fragments in docs/src are not covered by this build.
    </description>

    <properties>
        <!-- Must equal versionsConfig.current in .vitepress/config.mts
             and the latest <release> on Maven Central. Verified by CI. -->
        <ultitools.version>7.0.0</ultitools.version>
        <maven.compiler.release>25</maven.compiler.release>
        <lombok.version>1.18.48</lombok.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <repositories>
        <repository>
            <id>papermc</id>
            <url>https://repo.papermc.io/repository/maven-public/</url>
        </repository>
    </repositories>

    <dependencies>
        <dependency>
            <groupId>com.ultikits</groupId>
            <artifactId>UltiTools-API</artifactId>
            <version>${ultitools.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>io.papermc.paper</groupId>
            <artifactId>paper-api</artifactId>
            <!-- Match the stable Paper API build pinned by UltiTools-API. -->
            <version>26.3.build.258-stable</version>
            <scope>provided</scope>
        </dependency>
        <!-- Only present so the @Configuration/@Bean example can wrap a real
             connection pool. Same coordinates the framework itself declares. -->
        <dependency>
            <groupId>com.zaxxer</groupId>
            <artifactId>HikariCP</artifactId>
            <version>7.1.0</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <version>${lombok.version}</version>
            <scope>provided</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <configuration>
                    <!-- JDK 25 does not discover processors on the compile classpath by default. -->
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>${lombok.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
