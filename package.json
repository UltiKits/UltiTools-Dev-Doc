{
  "type": "module",
  "scripts": {
    "dev": "node scripts/generate-snapshot-sidebar.mjs && node scripts/generate-version-pages.mjs && vitepress dev",
    "build": "node scripts/generate-api-version.mjs && node scripts/generate-snapshot-sidebar.mjs && node scripts/generate-version-pages.mjs && vitepress build && node scripts/generate-redirects.mjs",
    "build:with-alpha": "node scripts/inject-alpha.mjs && npm run build",
    "clean:snapshot": "rm -rf docs/archive/v*-SNAPSHOT examples-snapshot .vitepress/config/.snapshot-source .vitepress/config/sidebar-snapshot.generated.mjs docs/public/snapshot-status.json",
    "preview": "vitepress preview",
    "typecheck": "node scripts/generate-snapshot-sidebar.mjs && tsc -p tsconfig.json",
    "check:parity": "bash scripts/check-bilingual-parity.sh",
    "check:version-signal": "bash scripts/test-version-signal.sh"
  },
  "devDependencies": {
    "@nolebase/vitepress-plugin-git-changelog": "^2.18.2",
    "@nolebase/vitepress-plugin-highlight-targeted-heading": "^2.18.2",
    "@nolebase/vitepress-plugin-inline-link-preview": "^2.18.2",
    "@types/node": "26.6.6",
    "@vite-pwa/vitepress": "^2.0.3",
    "@viteplus/versions": "^2.3.0",
    "sass": "^1.83.4",
    "typescript": "7.0.2",
    "vitepress": "^1.6.4",
    "vitepress-plugin-group-icons": "^1.3.5",
    "workbox-window": "^7.0.0"
  },
  "dependencies": {
    "typewriter-effect": "^3.3.0",
    "viewerjs": "^1.11.6",
    "vitepress-plugin-back-to-top": "^1.0.1",
    "vitepress-plugin-codeblocks-fold": "^1.2.28",
    "vitepress-plugin-comment-with-giscus": "^1.1.12",
    "vitepress-plugin-image-viewer": "^1.1.3",
    "vitepress-plugin-nprogress": "^0.0.4",
    "vitepress-plugin-tabs": "^0.5.0",
    "vue": "^3.5.13"
  },
  "overrides": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  }
}
