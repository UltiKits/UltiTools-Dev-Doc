### Maven ###
# Build output for the examples/ compilable-docs module
/examples/target/

# Python bytecode from running scripts/ locally
__pycache__/
*.pyc

# GSD planning artifacts (local only)
.planning/

# Claude Code / GSD local instruction file (local only)
.claude/

# GSD runtime state (local only)
.gsd/

# Eclipse / JDT-LS metadata generated when opening examples/ in an IDE
.classpath
.project
.factorypath
.settings/

# Generated at build time by scripts/generate-api-version.mjs (npm run build).
# Must NOT be committed: a committed copy is byte-identical to a stale build
# and silently masks a failed build-time injection (Cloudflare Pages "Build
# command" not running before functions/ is packaged) instead of failing
# closed. See .planning/phases/01-api-javadoc/01-01-SUMMARY.md.
functions/api/_shared/version.generated.js

# Generated at build time by scripts/inject-alpha.mjs (npm run build:with-alpha).
# Must NOT be committed: a committed copy would be byte-identical to a stale
# injection and would silently mask a failed build-time refresh of alpha's
# content instead of failing closed. See .planning/phases/03-alpha/03-01-PLAN.md.
docs/archive/v6.3.0-SNAPSHOT/

# Generated at build time by scripts/inject-alpha.mjs (npm run build:with-alpha).
# SNAPSHOT-only mirror of alpha's examples/src, kept separate from examples/
# so that latest and the six archived versions can never be made to render
# alpha's example code. Must NOT be committed for the same reason as
# docs/archive/v6.3.0-SNAPSHOT/ above.
examples-snapshot/

# Generated at build time by scripts/inject-alpha.mjs (npm run build:with-alpha).
# Raw sidebar.en.mts/sidebar.zh.mts landed from alpha, consumed only by
# scripts/generate-snapshot-sidebar.mjs. Must NOT be committed for the same
# reason as docs/archive/v6.3.0-SNAPSHOT/ above.
.vitepress/config/.snapshot-source/

# Generated at build time by scripts/generate-snapshot-sidebar.mjs (npm run
# build and npm run dev, always — not just build:with-alpha). Must NOT be
# committed: a committed copy would be byte-identical to a stale run and
# would silently mask a failed generation instead of failing closed.
.vitepress/config/sidebar-snapshot.generated.mjs

# Generated at build time by scripts/inject-alpha.mjs (npm run build:with-alpha).
# Copied into the deployed site root via docs/public/ (same mechanism as the
# existing docs/public/_redirects), read by the nightly workflow (03-02) to
# decide whether alpha has moved since the last injection. Must NOT be
# committed for the same reason as docs/archive/v6.3.0-SNAPSHOT/ above.
docs/public/snapshot-status.json
